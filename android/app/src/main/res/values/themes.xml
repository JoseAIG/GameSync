<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Always dark, like every console client.  The window background, status
      bar and navigation bar start out in GsColors.Bg (#0F1720), so launch
      and rotation never flash white before Compose draws its first frame.
    -->
    <style name="Theme.GameSync" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/gs_bg</item>
        <item name="android:statusBarColor">@color/gs_bg</item>
        <item name="android:navigationBarColor">@color/gs_bg</item>
        <item name="android:dialogTheme">@style/Theme.GameSync.Dialog</item>
    </style>

    <!--
      Dialog windows don't animate: each GsDialog card scales and fades in
      and out itself (GsDialogMotion), and a window animation would play on
      top of it.  The window's dim is kept (see GsDialogMotion).  The parent
      is what Theme.AppCompat inherits for android:dialogTheme.
    -->
    <style name="Theme.GameSync.Dialog" parent="android:Theme.Holo.Dialog">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>

# Copiar a deploy/.env (no se versiona) y completar.

# Key compartida por todos los clientes. Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_API_KEY=

# Nada sale a Internet: RetroAchievements (SYNC_RA_ENABLED), el proxy de
# actualizaciones (SYNC_UPDATE_PROXY_ENABLED) y el GameIndex.yaml de PS5SX2
# (SYNC_EMULATOR_INDEX_ENABLED) quedan en "false" en compose.yaml, que tiene
# prioridad sobre este archivo. Para activar uno, cambiarlo allí.

# Versiones anteriores que se guardan por juego.
SYNC_MAX_HISTORY_VERSIONS=10

# Límites de subida y de descompresión. Una subida al límite ocupa en RAM
# unas dos veces SYNC_MAX_DECOMPRESSED_BYTES más SYNC_MAX_UPLOAD_BYTES, que
# debe caber en el mem_limit de compose.yaml (768m). 128 MiB sobra para
# cualquier partida real.
SYNC_MAX_UPLOAD_BYTES=67108864
SYNC_MAX_DECOMPRESSED_BYTES=134217728

# Carpeta del host donde viven saves/ y las bases de datos
# (relativa a deploy/ o absoluta).
GAMESYNC_DATA_DIR=./data
GAMESYNC_LAN_PORT=8000

# Red Docker del túnel o proxy inverso que publica el servidor.
GAMESYNC_TUNNEL_NETWORK=gamesync_proxy

# Usuario con el que corre el contenedor (nunca root). Usa el UID del dueño
# de GAMESYNC_DATA_DIR para no necesitar sudo.
GAMESYNC_UID=10001
GAMESYNC_GID=10001
